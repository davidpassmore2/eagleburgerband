# ==============================================================================
# Eagleburger Band - Environment Variables Template
# Copy this file to .env.local for local overrides.
# ==============================================================================

# ------------------------------------------------------------------------------
# Firebase Client Configuration (Optional for local emulator dev)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=local-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=eagleburger-band-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=eagleburger-band-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "false" to connect to cloud Firebase (Beta / Prod), or "true" for local emulators
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# ------------------------------------------------------------------------------
# Cloudinary Media Hosting & Upload Widget (Unsigned Preset)
# Sign up free at https://cloudinary.com
# Create an Unsigned Upload Preset under: Settings -> Upload -> Upload Presets
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ------------------------------------------------------------------------------
# Firebase Admin SDK (Server-Side User Purge & Management)
# Optional in local emulator dev; required in Vercel to delete users from Firebase Auth
# Download private key JSON from: Firebase Console -> Project Settings -> Service Accounts
# ------------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY=

# ------------------------------------------------------------------------------
# Resend Transactional Email Deliverability
# Sign up at https://resend.com
# In local dev / emulator mode, omitting RESEND_API_KEY cleanly mocks all dispatches to console
# ------------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="Eagleburger Band <onboarding@resend.dev>"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

