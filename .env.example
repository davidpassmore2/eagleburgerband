# ==============================================================================
# Eagleburger Band - Environment Variables Template
# Copy this file to .env.local for local overrides.
# ==============================================================================

# ------------------------------------------------------------------------------
# Firebase Client Configuration (Optional for local emulator dev)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=local-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=eagleburger-band-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=eagleburger-band-dev.appspot.com

# ------------------------------------------------------------------------------
# Cloudinary Media Hosting & Upload Widget (Unsigned Preset)
# Sign up free at https://cloudinary.com
# Create an Unsigned Upload Preset under: Settings -> Upload -> Upload Presets
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
