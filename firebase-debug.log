[debug] [2026-09-09T21:25:01.820Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/eagleburger-band-dev:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n\r\n    function isAuthenticated() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function userDocExists() {\r\n      return exists(/databases/$(database)/documents/users/$(request.auth.uid));\r\n    }\r\n\r\n    function getUserData() {\r\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;\r\n    }\r\n\r\n    function isManager() {\r\n      return isAuthenticated() && (\r\n        (userDocExists() && \r\n         'role' in getUserData() && \r\n         getUserData().role in ['admin', 'manager', 'director']) ||\r\n        (request.auth.token.email != null && \r\n         request.auth.token.email.matches('.*@eagleburger\\\\.org$'))\r\n      );\r\n    }\r\n\r\n    // User profiles\r\n    match /users/{userId} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isAuthenticated() && (request.auth.uid == userId || isManager());\r\n    }\r\n\r\n    // Band sections & instrumentation\r\n    match /sections/{sectionId} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isManager();\r\n    }\r\n\r\n    // Sheet music library & charts\r\n    match /songs/{songId} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isManager();\r\n    }\r\n\r\n    // Gigs & logistics\r\n    match /gigs/{gigId} {\r\n      allow read: if true;\r\n      allow write: if isManager();\r\n\r\n      // Performer RSVPs subcollection\r\n      match /rsvps/{userId} {\r\n        allow read: if isAuthenticated();\r\n        allow write: if isAuthenticated() && (request.auth.uid == userId || isManager());\r\n      }\r\n\r\n      // Logistics change dispatch audit logs\r\n      match /dispatch_history/{historyId} {\r\n        allow read: if isAuthenticated();\r\n        allow write: if isManager();\r\n      }\r\n    }\r\n\r\n    // Public booking inquiries intake pipeline\r\n    match /inquiries/{inquiryId} {\r\n      allow create: if true;\r\n      allow read, update, delete: if isManager();\r\n    }\r\n\r\n    // System configurations & app state\r\n    match /config/{configId} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isManager();\r\n    }\r\n  }\r\n}"}]}}
