if true;\r\n      allow write: if request.auth != null;\r\n    }\r\n\r\n    match /suggestions/{suggestionId} {\r\n      allow read: if true;\r\n      allow write: if request.auth != null;\r\n    }\r\n\r\n    match /comments/{commentId} {\r\n      allow read: if true;\r\n      allow write: if request.auth != null;\r\n    }\r\n\r\n    match /theme/{themeId} {\r\n      allow read: if true;\r\n      allow write: if request.auth != null;\r\n    }\r\n\r\n    match /inquiries/{inquiryId} {\r\n      allow read, write: if true;\r\n    }\r\n  }\r\n}"}]}}
