[debug] [2026-09-09T21:23:33.810Z] >>> [apiv2][query] PUT http://127.0.0.1:8080/emulator/v1/projects/eagleburger-band-dev:securityRules [none]
[debug] [2026-09-09T21:23:33.811Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/eagleburger-band-dev:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n\r\n    // Helper functions\r\n    function isAuthenticated() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function getUserData() {\r\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;\r\n    }\r\n\r\n    function isManager() {\r\n      return isAuthenticated() && (\r\n        getUserData().role in ['admin', 'manager', 'director'] ||\r\n        request.auth.token.email.matches('.*@eagleburger\\\\.org$')\r\n      );\r\n    }\r\n\r\n    // User profiles\r\n    match /users/{userId} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isAuthenticated() && (request.auth.uid == userId || isManager());\r\n    }\r\n\r\n    // Band sections & instrumentation\r\n    match /sections/{sectionId} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isManager();\r\n    }\r\n\r\n    // Sheet music library & charts\r\n    match /songs/{songId} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isManager();\r\n    }\r\n\r\n    // Gigs & logistics\r\n    match /gigs/{gigId} {\r\n      allow read: if true; // Public view for calendar / public events, or authenticated\r\n      allow write: if isManager();\r\n\r\n      // Performer RSVPs subcollection\r\n      match /rsvps/{userId} {\r\n        allow read: if isAuthenticated();\r\n        allow write: if isAuthenticated() && (request.auth.uid == userId || isManager());\r\n      }\r\n\r\n      // Stage 17: Logistics change dispatch audit logs\r\n      match /dispatch_history/{historyId} {\r\n        allow read: if isAuthenticated();\r\n        allow write: if isManager();\r\n      }\r\n    }\r\n\r\n    // Stage 16: Public booking inquiries intake pipeline\r\n    match /inquiries/{inquiryId} {\r\n      // Anyone can submit an inquiry from the public /book page\r\n      allow create: if true;\r\n      // Only band managers can review, update status, or convert inquiries\r\n      allow read, update, delete: if isManager();\r\n    }\r\n\r\n    // System configurations & app state\r\n    match /config/{configId} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isManager();\r\n    }\r\n  }\r\n}"}]}}
