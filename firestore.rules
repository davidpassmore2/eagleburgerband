rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user has admin privileges
    function isAdmin() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
      );
    }

    // Allow development and authenticated access across collections
    match /{document=**} {
      allow read, write: if true; // Set to true for local emulator development
    }

    // Specific collection rules for production readiness:
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /sections/{sectionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /songs/{songId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /tunes/{tuneId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /setlists/{setlistId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /gigs/{gigId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /rsvps/{userId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /dispatch_history/{dispatchId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    match /contacts/{contactId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /suggestions/{suggestionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /theme/{themeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /content_pages/{pageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    match /booking_leads/{leadId} {
      allow read, write: if true;
    }

    match /donations/{donationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}